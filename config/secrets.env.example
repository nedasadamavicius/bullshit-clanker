# Copy to config/secrets.env (gitignored) and paste your key.
# Default provider is Claude. One key, one provider. No export needed.
#
# Console key from https://console.anthropic.com/settings/keys
# (Claude.ai / Claude Code login is not an API key.)

ANTHROPIC_API_KEY=

# Optional:
# BC_PROVIDER=claude
# BC_MODEL=claude-sonnet-4-5
# BC_API_BASE=https://api.anthropic.com/v1
#
# Switch provider later in this same file:
# BC_PROVIDER=xai
# XAI_API_KEY=
